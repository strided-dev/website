---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DumpForm from '../components/DumpForm.tsx';
import '../styles/submit.css';
---
<Base title="Share a workload | strided" description="Bring a real inference workload to strided. Share a redacted Nsight or DCGM capture and get a diagnosis from the team.">
  <Nav />
  <main id="main" class="submit-main container">
    <div class="submit-intro">
      <a href="/" class="text-link back-link"><span aria-hidden="true">←</span> Back to strided</a>
      <p class="eyebrow">Workload review</p>
      <h1>Better evidence.<br />Better answers.</h1>
      <p class="submit-description">Bring us the workload that's hard to explain. We'll run your capture through strided and share what the evidence tells us.</p>
      <div class="submission-guide">
        <h2>What makes a useful capture</h2>
        <ul role="list">
          <li><strong>A real workload</strong><p>A Nsight or DCGM capture from an inference run.</p></li>
          <li><strong>A little context</strong><p>The model, hardware, and behavior you're investigating.</p></li>
          <li><strong>Only what you can share</strong><p>Remove credentials, customer data, and sensitive information before uploading.</p></li>
        </ul>
      </div>
      <p class="submit-contact">Prefer to start with a conversation?<br /><a href="mailto:hello@strided.dev">hello@strided.dev ↗</a></p>
    </div>
    <section class="submit-form" aria-labelledby="form-title">
      <div class="form-heading"><h2 id="form-title">Share your workload</h2><p>Required fields are marked with an asterisk.</p></div>
      <DumpForm client:load />
      <noscript><p class="no-script">Enable JavaScript to upload a capture, or contact <a href="mailto:hello@strided.dev">hello@strided.dev</a>.</p></noscript>
    </section>
  </main>
  <Footer />
</Base>
