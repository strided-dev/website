---
import { selected } from '../design-system.json';
interface Props { size?: number; class?: string; }
const { size = 42, class: className = '' } = Astro.props;
const { logo } = selected;
const { x, y, width, height } = logo.viewBox;
---
<svg width={size * width / height} height={size} viewBox={`${x} ${y} ${width} ${height}`} class={className} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {logo.bars.map(bar => <rect x={bar.offset} y={bar.y} width={bar.width} height={bar.height} rx={logo.radius} fill={bar.fill} opacity={bar.opacity} stroke={bar.outline} stroke-width={bar.outlineWidth} />)}
</svg>
