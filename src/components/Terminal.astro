---
import TypedTerminal from "./TypedTerminal.tsx";
// VIDEO SLOT: when the recorded demo is ready, swap <TypedTerminal /> for a
// <DemoVideo /> component, or place it directly above the terminal.
---

<section class="demo">
  <div class="section-label">Sample output</div>
  <TypedTerminal client:visible />
</section>

<style is:global>
  .demo {
    padding: var(--pad-y) var(--pad-x);
    border-bottom: 0.5px solid var(--border-primary);
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 1.5px;
    color: var(--text-tertiary); text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .term-shell { max-width: 920px; margin: 0 auto; }

  /* ---- skin toggle (segmented) ---- */
  .skin-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    margin: 0 auto var(--space-4);
    border: 0.5px solid var(--border-primary);
    border-radius: 7px;
    background: var(--paper-inset);
    font-family: var(--font-mono);
    font-size: 12px;
    transition: opacity var(--dur-fast) var(--ease-instrument);
  }
  .skin-toggle button {
    border: 0; cursor: pointer;
    padding: 5px 14px; border-radius: 5px;
    background: transparent; color: var(--text-secondary);
    font-family: inherit; font-size: inherit;
    transition: background var(--dur-fast) var(--ease-instrument),
                color var(--dur-fast) var(--ease-instrument);
  }
  .skin-toggle button:hover { color: var(--text-primary); }
  .skin-toggle button.active {
    background: var(--amber); color: #2C2C2A; font-weight: 500;
  }

  /* ---- window frame (always dark, both themes) ---- */
  .window {
    background: var(--fixed-dark-paper);
    border: 0.5px solid var(--fixed-dark-border);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(0,0,0,0.45),
                0 4px 12px -6px rgba(0,0,0,0.3);
  }

  /* ---- title bar ---- */
  .titlebar {
    display: flex; align-items: center; gap: var(--space-3);
    height: 38px; padding: 0 14px;
    background: #232320;
    border-bottom: 0.5px solid var(--fixed-dark-border);
    font-family: var(--font-mono);
    position: relative;
  }
  .titlebar .title {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; color: var(--fixed-dark-secondary);
    letter-spacing: 0.2px;
  }
  .title-mark { display: block; flex-shrink: 0; }
  .titlebar .ver { font-size: 11px; color: var(--fixed-dark-dim); }

  /* mac: dots left, title centered, version right */
  .window.mac .dots { display: inline-flex; gap: 8px; }
  .window.mac .d { width: 12px; height: 12px; border-radius: 50%; display: block; }
  .window.mac .d.red { background: #ED6A5E; }
  .window.mac .d.yellow { background: #F4BE4F; }
  .window.mac .d.green { background: #61C554; }
  .window.mac .title {
    position: absolute; left: 50%; transform: translateX(-50%);
  }
  .window.mac .ver { margin-left: auto; }

  /* windows: title left, version + controls right */
  .window.win .titlebar { background: #1F1F1C; }
  .window.win .win-title { font-weight: 500; }
  .window.win .ver { margin-left: auto; margin-right: var(--space-3); }
  .window.win .winctl { display: inline-flex; align-items: center; gap: 16px; }
  .window.win .wc { width: 11px; height: 11px; display: block; position: relative; opacity: 0.6; }
  .window.win .wc.min::before {
    content: ""; position: absolute; bottom: 1px; left: 0; right: 0;
    height: 1px; background: var(--fixed-dark-secondary);
  }
  .window.win .wc.max { border: 1px solid var(--fixed-dark-secondary); border-radius: 1px; }
  .window.win .wc.close::before,
  .window.win .wc.close::after {
    content: ""; position: absolute; top: 50%; left: 0; right: 0;
    height: 1px; background: var(--fixed-dark-secondary);
  }
  .window.win .wc.close::before { transform: rotate(45deg); }
  .window.win .wc.close::after { transform: rotate(-45deg); }

  /* ---- body ---- */
  .term-body {
    padding: clamp(18px, 3vw, 28px) clamp(18px, 3vw, 32px);
    font-family: var(--font-mono);
    font-size: clamp(11px, 0.7rem + 0.3vw, 13px);
    line-height: 1.75;
    color: #D8D6CE;
    min-height: 420px;
    overflow-x: auto;
  }

  .term-cmd { margin-bottom: var(--space-3); word-break: break-word; }
  .term-cmd .prompt { color: #6FB3C9; }                 /* prompt accent */
  .window.win .term-cmd .prompt { color: #5BA8D6; }      /* PS blue-ish */
  .term-cmd .input { color: #F1EFE8; }
  .caret {
    display: inline-block; width: 7px; height: 15px;
    background: var(--amber); margin-left: 2px;
    transform: translateY(2px);
    animation: blink 1.05s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .blk { animation: streamline 0.22s var(--ease-instrument); }
  @keyframes streamline {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .term-section { color: var(--fixed-dark-dim); font-size: 11px; letter-spacing: 0.5px; margin: 18px 0 6px; }
  .term-row { display: flex; flex-wrap: wrap; }
  .term-key { color: var(--fixed-dark-tertiary); width: 140px; flex-shrink: 0; }
  .term-val { color: var(--fixed-dark-ink); }
  .term-val.warn { color: var(--amber); }
  .term-aside { color: var(--fixed-dark-dim); margin-left: var(--space-3); }

  .diag-header { display: flex; align-items: baseline; gap: var(--space-3); margin: var(--space-6) 0 12px; flex-wrap: wrap; }
  .diag-marker { color: var(--amber); font-weight: 500; letter-spacing: 0.5px; }
  .diag-meta { color: var(--fixed-dark-dim); }

  .diagnosis-block { border-left: 2px solid var(--amber); padding: 4px 0 4px var(--space-4); margin: var(--space-4) 0; }
  .diagnosis-block.secondary { border-left-color: var(--fixed-dark-secondary); }
  .diag-head { display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-2); flex-wrap: wrap; }
  .diag-title { color: var(--fixed-dark-ink); font-weight: 500; font-size: 14px; }
  .diag-id { color: var(--fixed-dark-dim); font-size: 11px; }
  .diag-pct { color: var(--amber); margin-left: auto; }
  .diag-body { color: var(--fixed-dark-secondary); margin-bottom: 6px; }
  .diag-key { color: var(--fixed-dark-dim); display: inline-block; width: 72px; }
  .diag-evidence { color: var(--fixed-dark-dim); font-size: 11px; margin-top: var(--space-2); word-break: break-word; }

  .term-footer {
    margin-top: 24px; padding-top: var(--space-4);
    border-top: 0.5px solid var(--fixed-dark-border);
    color: var(--fixed-dark-dim); font-size: 11px;
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .apply-btn {
    margin-left: auto;
    font-family: var(--font-mono); font-size: 12px;
    color: var(--fixed-dark-ink); background: transparent;
    border: 0.5px solid var(--fixed-dark-secondary);
    border-radius: 5px; padding: 6px 13px; cursor: pointer;
    transition: all var(--dur-fast) var(--ease-instrument);
  }
  .apply-btn:hover { background: var(--amber); color: #2C2C2A; border-color: var(--amber); }
  .term-footer .docs { color: var(--fixed-dark-dim); }

  @media (max-width: 560px) {
    .term-body { min-height: 400px; }
    .term-key { width: 104px; }
    .diag-pct { margin-left: 0; }
    .window.mac .title { position: static; transform: none; }
    .apply-btn { margin-left: 0; }
  }
</style>
