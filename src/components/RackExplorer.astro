---
import { rack, scenario, objectives, cubePaths, CAPACITY_KW, GPU_LIMIT_KW } from '../lib/rack-model';
const baseline = scenario('baseline');
---
<div class="rack-explorer" data-rack-explorer>
  <div class="rack-toolbar">
    <fieldset class="rack-objectives" data-objectives disabled>
      <legend class="sr-only">Choose a rack objective</legend>
      {objectives.map(objective => <button type="button" data-objective={objective.key} aria-pressed={objective.key === 'baseline'} aria-controls="rack-summary rack-metrics">{objective.label}</button>)}
    </fieldset>
    <span class="rack-example">Illustrative model</span>
  </div>

  <div class="rack-display">
    <figure class="rack-figure">
      <div class="rack-legend" aria-label="How to read the cubes">
        <span><i class="solid-key" aria-hidden="true"></i>Useful work share</span>
        <span><i class="wire-key" aria-hidden="true"></i>Remaining draw</span>
      </div>
      <svg class="rack-view" viewBox="0 0 780 452" role="img" aria-labelledby="rack-title rack-description">
        <title id="rack-title">One rack, forty-eight GPUs</title>
        <desc id="rack-description">An isometric model with one cube per GPU. Total height represents modeled power draw. The solid portion is the illustrative share attributed to useful work; the open portion is the remainder. Aggregate values appear below.</desc>
        {rack.map((cell, index) => {
          const paths = cubePaths(cell, baseline.allocation[index]);
          return <g data-cube>
            <path class="cube-wire" data-face="wire" d={paths.wire} />
            <path class="cube-left" data-face="left" d={paths.left} />
            <path class="cube-right" data-face="right" d={paths.right} />
            <path class="cube-top" data-face="top" d={paths.top} />
          </g>;
        })}
      </svg>
      <figcaption>48 GPUs. One cube each. Height represents power draw.</figcaption>
    </figure>

    <div class="rack-summary" id="rack-summary">
      <p class="eyebrow" data-objective-name>Baseline</p>
      <h3 data-objective-title>{objectives[0].title}</h3>
      <p class="rack-explanation" data-objective-description>{objectives[0].description}</p>
      <p class="rack-constraint" data-objective-constraint>{objectives[0].constraint}</p>
    </div>
  </div>

  <dl class="rack-metrics" id="rack-metrics">
    <div><dt>GPU power draw</dt><dd><span data-metric="draw">{baseline.draw.toFixed(1)}</span> <span class="metric-unit">kW</span><span class="metric-note">Across the same 48 GPUs</span></dd></div>
    <div><dt>Useful work index</dt><dd><span data-metric="work">{baseline.workIndex}</span><span class="metric-note">Relative model value; baseline = 100</span></dd></div>
    <div><dt>Power headroom</dt><dd><span data-metric="headroom">{baseline.headroom.toFixed(1)}</span> <span class="metric-unit">kW</span><span class="metric-note">Within the assumed GPU power limit</span></dd></div>
  </dl>
  <p class="sr-only" role="status" aria-atomic="true" data-rack-announcement></p>
  <p class="rack-disclosure">A model of tradeoffs, not a benchmark. These scenarios do not predict production performance or savings.</p>
  <details class="rack-assumptions">
    <summary>About this model</summary>
    <p>The same 48 synthetic GPU samples are used for every objective. Each GPU has an assumed {GPU_LIMIT_KW * 1000} W limit, totaling {CAPACITY_KW.toFixed(2)} kW. The solid share is an illustrative allocation to useful work, not a measurement of electrical conversion efficiency. The work index is the sum of draw × useful share, relative to the baseline. CPU, networking, and cooling power are excluded. No latency or financial outcome is calculated.</p>
  </details>
  <noscript><p class="rack-disclosure">The baseline is shown above. Enable JavaScript to explore the other objectives.</p></noscript>
</div>

<script>
  import { rack, scenario, objectives, cubePaths, type Objective } from '../lib/rack-model';

  document.querySelectorAll<HTMLElement>('[data-rack-explorer]').forEach(root => {
    const controls = root.querySelector<HTMLFieldSetElement>('[data-objectives]')!;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-objective]')];
    const cubes = [...root.querySelectorAll<SVGGElement>('[data-cube]')].map(cube => ({
      wire: cube.querySelector<SVGPathElement>('[data-face="wire"]')!,
      left: cube.querySelector<SVGPathElement>('[data-face="left"]')!,
      right: cube.querySelector<SVGPathElement>('[data-face="right"]')!,
      top: cube.querySelector<SVGPathElement>('[data-face="top"]')!,
    }));
    const name = root.querySelector<HTMLElement>('[data-objective-name]')!;
    const title = root.querySelector<HTMLElement>('[data-objective-title]')!;
    const description = root.querySelector<HTMLElement>('[data-objective-description]')!;
    const constraint = root.querySelector<HTMLElement>('[data-objective-constraint]')!;
    const draw = root.querySelector<HTMLElement>('[data-metric="draw"]')!;
    const work = root.querySelector<HTMLElement>('[data-metric="work"]')!;
    const headroom = root.querySelector<HTMLElement>('[data-metric="headroom"]')!;
    const announcement = root.querySelector<HTMLElement>('[data-rack-announcement]')!;
    let active: Objective = 'baseline';

    // No animation loop, timers, observers, or idle work. The initial SVG is
    // already rendered. Reuse its 192 paths and update only on user input.
    controls.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-objective]');
      const objective = objectives.find(item => item.key === button?.dataset.objective);
      if (!objective || objective.key === active) return;
      active = objective.key;
      const state = scenario(active);
      cubes.forEach((cube, index) => {
        const paths = cubePaths(rack[index], state.allocation[index]);
        cube.wire.setAttribute('d', paths.wire);
        cube.left.setAttribute('d', paths.left);
        cube.right.setAttribute('d', paths.right);
        cube.top.setAttribute('d', paths.top);
      });
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      name.textContent = objective.label;
      title.textContent = objective.title;
      description.textContent = objective.description;
      constraint.textContent = objective.constraint;
      draw.textContent = state.draw.toFixed(1);
      work.textContent = String(state.workIndex);
      headroom.textContent = state.headroom.toFixed(1);
      announcement.textContent = `${objective.label}. Modeled GPU draw ${state.draw.toFixed(1)} kilowatts, useful work index ${state.workIndex}, power headroom ${state.headroom.toFixed(1)} kilowatts. ${objective.constraint}`;
    });
    controls.disabled = false;
  });
</script>

<style>
  .rack-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  .rack-objectives { display: flex; flex-wrap: wrap; gap: 12px 26px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .rack-objectives button { position: relative; border: 0; background: transparent; color: var(--text-secondary); padding: 12px 0; min-height: 46px; font-size: 13px; }
  .rack-objectives button[aria-pressed='true'] { color: var(--ink); font-weight: 500; }
  .rack-objectives button[aria-pressed='true']::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--ink); }
  .rack-example { color: var(--text-secondary); font-size: 11px; white-space: nowrap; }
  .rack-display { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr); align-items: center; gap: 48px; }
  .rack-figure { min-width: 0; }
  .rack-legend { display: flex; flex-wrap: wrap; gap: 12px 26px; font-size: 11px; color: var(--text-secondary); }
  .rack-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .rack-legend i { display: inline-block; width: 9px; height: 9px; }
  .solid-key { background: var(--ink); }
  .wire-key { border: 1px solid var(--text-secondary); }
  .rack-view { width: 100%; height: auto; aspect-ratio: 780 / 452; margin-top: 12px; }
  .cube-wire { fill: none; stroke: var(--text-secondary); stroke-width: .8; vector-effect: non-scaling-stroke; }
  .cube-top { fill: var(--strided-accent); }
  .cube-left { fill: var(--ink); }
  .cube-right { fill: var(--text-secondary); }
  .rack-figure figcaption { font-size: 11px; color: var(--text-secondary); margin-top: 12px; }
  .rack-summary { min-height: 310px; }
  .rack-summary h3 { font-size: clamp(29px, 2.6vw, 37px); margin-top: 22px; line-height: 1.15; }
  .rack-explanation { font-size: 13px; line-height: 1.85; color: var(--text-secondary); margin-top: 22px; }
  .rack-constraint { font-size: 12px; line-height: 1.8; margin-top: 24px; }
  .rack-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 44px 0 0; }
  .rack-metrics > div { display: flex; flex-direction: column; }
  .rack-metrics dt { font-size: 12px; color: var(--text-secondary); }
  .rack-metrics dd { font: 400 46px/1.1 var(--font-display); letter-spacing: -.025em; font-variant-numeric: tabular-nums; margin: 12px 0 0; }
  .metric-unit { font-size: 25px; letter-spacing: normal; }
  .metric-note { display: block; font: 400 11px/1.65 var(--font-sans); letter-spacing: normal; color: var(--text-secondary); margin-top: 8px; }
  .rack-disclosure { font-size: 11px; color: var(--text-secondary); margin-top: 34px; max-width: 720px; }
  .rack-assumptions { font-size: 11px; color: var(--text-secondary); margin-top: 8px; }
  .rack-assumptions summary { cursor: pointer; width: fit-content; padding-block: 8px; }
  .rack-assumptions p { max-width: 780px; margin-top: 8px; line-height: 1.8; }
  @media (max-width: 1050px) { .rack-display { gap: 32px; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); } }
  @media (max-width: 760px) {
    .rack-toolbar { flex-wrap: wrap; gap: 16px; margin-bottom: 26px; }
    .rack-objectives { gap: 8px 22px; width: 100%; }
    .rack-example { font-size: 10px; }
    .rack-display { grid-template-columns: 1fr; gap: 36px; }
    .rack-summary { min-height: 0; max-width: 500px; }
    .rack-summary h3 { font-size: 34px; margin-top: 15px; max-width: 340px; }
    .rack-explanation { margin-top: 16px; }
    .rack-constraint { margin-top: 16px; }
    .rack-metrics { gap: 20px; margin-top: 36px; }
    .rack-metrics dd { font-size: 36px; }
    .metric-unit { font-size: 18px; }
    .rack-metrics dt, .metric-note { font-size: 10px; }
  }
  @media (max-width: 400px) {
    .rack-objectives { gap: 8px 17px; }
    .rack-objectives button { font-size: 12px; }
    .rack-legend { gap: 12px 18px; font-size: 10px; }
    .rack-metrics { grid-template-columns: 1fr 1fr; gap: 24px; }
  }
</style>
