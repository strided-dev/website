---
import { cells, scenario, workloads, cubePaths, cubeOpacity, CAPACITY_GIB, BLOCK_GIB, MODEL_GIB } from '../lib/local-model';
const loaded = scenario('loaded');
---
<div class="model-explorer" data-model-explorer>
  <div class="model-toolbar">
    <fieldset class="model-workloads" data-workloads disabled>
      <legend class="sr-only">Choose a workload</legend>
      {workloads.map(workload => <button type="button" data-workload={workload.key} aria-pressed={workload.key === 'loaded'} aria-controls="model-summary model-metrics">{workload.label}</button>)}
    </fieldset>
    <span class="model-example">Illustrative example</span>
  </div>

  <div class="model-display">
    <figure class="model-figure">
      <div class="model-legend" aria-label="How to read the memory blocks">
        <span><i class="solid-key" aria-hidden="true"></i>In use</span>
        <span><i class="wire-key" aria-hidden="true"></i>Free</span>
      </div>
      <svg class="model-view" viewBox="0 0 780 452" role="img" aria-labelledby="model-title" aria-describedby="model-description" aria-busy="false">
        <title id="model-title">GPU memory on one vivace host</title>
        <desc id="model-description">Forty-eight blocks represent 24 GiB of GPU memory on one vivace host. Each block is half a GiB. Filled blocks hold model weights, runtime buffers, or cached tokens; open blocks are free. Aggregate values appear below.</desc>
        {cells.map((cell, index) => {
          const paths = cubePaths(cell, loaded.allocation[index]);
          return <g data-cube>
            <path class="cube-wire" data-face="wire" d={paths.wire} />
            <g data-solid opacity={cubeOpacity(loaded.allocation[index])}>
              <path class="cube-left" data-face="left" d={paths.left} />
              <path class="cube-right" data-face="right" d={paths.right} />
              <path class="cube-top" data-face="top" d={paths.top} />
            </g>
          </g>;
        })}
      </svg>
      <figcaption>One vivace host. Each block represents {BLOCK_GIB} GiB of GPU memory.</figcaption>
    </figure>

    <div class="model-summary" id="model-summary">
      <p class="eyebrow" data-workload-name>{loaded.label}</p>
      <h4 data-workload-title>{loaded.title}</h4>
      <p class="model-explanation" data-workload-description>{loaded.description}</p>
      <p class="model-constraint" data-workload-constraint>{loaded.constraint}</p>
      <p class="model-setting">Context limit <span data-metric="context">{loaded.context.toLocaleString('en-US')}</span> tokens per sequence</p>
    </div>
  </div>

  <dl class="model-metrics" id="model-metrics">
    <div><dt>GPU memory in use</dt><dd><span data-metric="memory">{loaded.usedGiB.toFixed(1)}</span> <span class="metric-unit">GiB</span><span class="metric-note">Weights, runtime buffers, and cached tokens</span></dd></div>
    <div><dt>Sequences running</dt><dd><span data-metric="requests">{loaded.requests}</span><span class="metric-note">Conversations or prompts decoding together</span></dd></div>
    <div><dt>Free memory</dt><dd><span data-metric="headroom">{loaded.headroom.toFixed(1)}</span> <span class="metric-unit">GiB</span><span class="metric-note">Within the same 24 GiB of GPU memory</span></dd></div>
  </dl>
  <p class="sr-only" role="status" aria-atomic="true" data-model-announcement></p>
  <p class="model-disclosure">An illustration of how vivace uses memory as the work changes. These are example values, not a live host or measured results.</p>
  <details class="model-assumptions">
    <summary>About this example</summary>
    <p>This synthetic host has {CAPACITY_GIB} GiB of GPU memory and {MODEL_GIB} GiB of resident model weights. Memory in use is the sum of the weights, runtime buffers, and KV cache blocks holding tokens. vivace reserves its KV pool when the model loads; the filled blocks here are the ones holding tokens. Cache sizes are assumed, not calculated from a specific model architecture. When the pool fills, parked conversations give up their least recently used blocks first, keeping their longest prefix, before any running sequence is preempted. No speed or latency improvement is predicted.</p>
  </details>
  <noscript><p class="model-disclosure">The loaded model is shown above. Enable JavaScript to explore the other workloads.</p></noscript>
</div>

<script>
  import { cells, scenario, workloads, cubeSolidPaths, cubeOpacity, BLOCK_GIB, CAPACITY_GIB, type Workload } from '../lib/local-model';

  document.querySelectorAll<HTMLElement>('[data-model-explorer]').forEach(root => {
    const controls = root.querySelector<HTMLFieldSetElement>('[data-workloads]')!;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-workload]')];
    const cubes = [...root.querySelectorAll<SVGGElement>('[data-cube]')].map(cube => ({
      solid: cube.querySelector<SVGGElement>('[data-solid]')!,
      left: cube.querySelector<SVGPathElement>('[data-face="left"]')!,
      right: cube.querySelector<SVGPathElement>('[data-face="right"]')!,
      top: cube.querySelector<SVGPathElement>('[data-face="top"]')!,
    }));
    const name = root.querySelector<HTMLElement>('[data-workload-name]')!;
    const title = root.querySelector<HTMLElement>('[data-workload-title]')!;
    const description = root.querySelector<HTMLElement>('[data-workload-description]')!;
    const constraint = root.querySelector<HTMLElement>('[data-workload-constraint]')!;
    const memory = root.querySelector<HTMLElement>('[data-metric="memory"]')!;
    const requests = root.querySelector<HTMLElement>('[data-metric="requests"]')!;
    const context = root.querySelector<HTMLElement>('[data-metric="context"]')!;
    const headroom = root.querySelector<HTMLElement>('[data-metric="headroom"]')!;
    const announcement = root.querySelector<HTMLElement>('[data-model-announcement]')!;
    const view = root.querySelector<SVGSVGElement>('.model-view')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active: Workload = 'loaded';
    let target = scenario(active);
    let displayed = target.allocation;
    let frame = 0;

    function draw(allocation: number[]) {
      cubes.forEach((cube, index) => {
        if (allocation[index] === displayed[index]) return;
        const paths = cubeSolidPaths(cells[index], allocation[index]);
        cube.left.setAttribute('d', paths.left);
        cube.right.setAttribute('d', paths.right);
        cube.top.setAttribute('d', paths.top);
        const opacity = String(cubeOpacity(allocation[index]));
        if (cube.solid.getAttribute('opacity') !== opacity) cube.solid.setAttribute('opacity', opacity);
      });
      displayed = allocation;
      const used = allocation.reduce((total, value) => total + value * BLOCK_GIB, 0);
      memory.textContent = used.toFixed(1);
      headroom.textContent = (CAPACITY_GIB - used).toFixed(1);
    }

    function finish() {
      cancelAnimationFrame(frame);
      frame = 0;
      draw(target.allocation);
      view.setAttribute('aria-busy', 'false');
      announcement.textContent = `${target.label}. GPU memory in use ${target.usedGiB.toFixed(1)} GiB, ${target.requests} ${target.requests === 1 ? 'sequence' : 'sequences'} running, context limit ${target.context} tokens per sequence, free memory ${target.headroom.toFixed(1)} GiB. ${target.constraint}`;
    }

    function animate() {
      cancelAnimationFrame(frame);
      const bounds = view.getBoundingClientRect();
      if (reducedMotion.matches || document.hidden || bounds.bottom <= 0 || bounds.top >= window.innerHeight || target.allocation.every((value, index) => value === displayed[index])) {
        finish();
        return;
      }
      const from = displayed.slice();
      const started = performance.now();
      view.setAttribute('aria-busy', 'true');
      announcement.textContent = '';
      // One finite transition. Only changing faces are redrawn; capacity
      // outlines stay fixed, and no frames are scheduled once settled.
      function step(now: number) {
        const progress = Math.min(1, (now - started) / 1400);
        if (progress === 1) {
          finish();
          return;
        }
        const eased = 1 - Math.pow(1 - progress, 3);
        draw(from.map((value, index) => value + (target.allocation[index] - value) * eased));
        frame = requestAnimationFrame(step);
      }
      frame = requestAnimationFrame(step);
    }

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches && frame) finish();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && frame) finish();
    });
    new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting && frame) finish();
    }).observe(view);

    controls.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-workload]');
      const workload = workloads.find(item => item.key === button?.dataset.workload);
      if (!workload || workload.key === active) return;
      active = workload.key;
      target = scenario(active);
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      name.textContent = workload.label;
      title.textContent = workload.title;
      description.textContent = workload.description;
      constraint.textContent = workload.constraint;
      requests.textContent = String(target.requests);
      context.textContent = target.context.toLocaleString('en-US');
      animate();
    });
    controls.disabled = false;
  });
</script>

<style>
  .model-setting { font-size: 11px; color: var(--text-secondary); margin-top: 16px; }
  .model-setting span { font-variant-numeric: tabular-nums; color: var(--strided-purple); }

  .model-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  .model-workloads { display: flex; flex-wrap: wrap; gap: 12px 26px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .model-workloads button { position: relative; border: 0; background: transparent; color: var(--text-secondary); padding: 12px 0; min-height: 46px; font-size: 13px; }
  .model-workloads button[aria-pressed='true'] { color: var(--ink); font-weight: 500; }
  .model-workloads button[aria-pressed='true']::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--ink); }
  .model-example { color: var(--text-secondary); font-size: 11px; white-space: nowrap; }
  .model-display { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr); align-items: center; gap: 48px; }
  .model-figure { min-width: 0; }
  .model-legend { display: flex; flex-wrap: wrap; gap: 12px 26px; font-size: 11px; color: var(--text-secondary); }
  .model-legend span { display: inline-flex; align-items: center; gap: 8px; }
  .model-legend i { display: inline-block; width: 9px; height: 9px; }
  .solid-key { background: var(--ink); }
  .wire-key { border: 1px solid var(--text-secondary); }
  .model-view { width: 100%; height: auto; aspect-ratio: 780 / 452; margin-top: 12px; }
  .cube-wire { fill: none; stroke: var(--text-secondary); stroke-width: .8; vector-effect: non-scaling-stroke; }
  .cube-top { fill: var(--strided-accent); }
  .cube-left { fill: var(--ink); }
  .cube-right { fill: var(--text-secondary); }
  .model-figure figcaption { font-size: 11px; color: var(--text-secondary); margin-top: 12px; }
  .model-summary { min-height: 350px; }
  .model-summary h4 { font-size: clamp(29px, 2.6vw, 37px); margin-top: 22px; line-height: 1.15; }
  .model-explanation { font-size: 15px; line-height: 1.75; color: var(--text-secondary); margin-top: 22px; }
  .model-constraint { font-size: 14px; line-height: 1.7; margin-top: 24px; color: var(--strided-purple); }
  .model-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 44px 0 0; }
  .model-metrics > div { display: flex; flex-direction: column; }
  .model-metrics dt { font-size: 12px; color: var(--text-secondary); }
  .model-metrics dd { font: 400 46px/1.1 var(--font-display); letter-spacing: -.025em; font-variant-numeric: tabular-nums; margin: 12px 0 0; }
  .metric-unit { font-size: 25px; letter-spacing: normal; }
  .metric-note { display: block; font: 400 11px/1.65 var(--font-sans); letter-spacing: normal; color: var(--text-secondary); margin-top: 8px; }
  .model-disclosure { font-size: 13px; line-height: 1.65; color: var(--text-secondary); margin-top: 34px; max-width: 760px; }
  .model-assumptions { font-size: 13px; color: var(--text-secondary); margin-top: 8px; }
  .model-assumptions summary { cursor: pointer; width: fit-content; padding-block: 8px; }
  .model-assumptions p { max-width: 780px; margin-top: 8px; line-height: 1.8; }
  @media (max-width: 1050px) { .model-display { gap: 32px; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); } }
  @media (max-width: 760px) {
    .model-toolbar { flex-wrap: wrap; gap: 16px; margin-bottom: 26px; }
    .model-workloads { gap: 8px 22px; width: 100%; }
    .model-example { font-size: 10px; }
    .model-display { grid-template-columns: 1fr; gap: 36px; }
    .model-summary { min-height: 0; max-width: 500px; }
    .model-summary h4 { font-size: 34px; margin-top: 15px; max-width: 340px; }
    .model-explanation { margin-top: 16px; }
    .model-constraint { margin-top: 16px; }
    .model-metrics { gap: 20px; margin-top: 36px; }
    .model-metrics dd { font-size: 36px; }
    .metric-unit { font-size: 18px; }
    .model-metrics dt, .metric-note { font-size: 10px; }
  }
  @media (max-width: 400px) {
    .model-workloads { gap: 8px 17px; }
    .model-workloads button { font-size: 12px; }
    .model-legend { gap: 12px 18px; font-size: 10px; }
    .model-metrics { grid-template-columns: 1fr 1fr; gap: 24px; }
  }
</style>
