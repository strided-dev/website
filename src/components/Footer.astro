---
import Logo from './Logo.astro';
---
<footer class="site-footer container">
  <div class="footer-top">
    <a href="/" class="footer-brand" aria-label="Strided home"><Logo size={54} /></a>
    <p>Every layer.<br />One accountable system.</p>
    <a href="mailto:hello@strided.dev" class="text-link">hello@strided.dev <span class="arrow" aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Strided</span><span>Explain. Reproduce. Verify.</span><a href="#main">Back to top ↑</a></div>
</footer>
<style>
  .site-footer { padding-block: 44px 24px; }
  .footer-top { display: flex; align-items: center; gap: 60px; padding-bottom: 35px; }
  .footer-brand { display: flex; text-decoration: none; }
  .footer-top > p { font-size: 12px; color: var(--text-secondary); line-height: 1.6; }
  .footer-top > a:last-child { margin-left: auto; font-size: 12px; gap: 22px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 22px; color: var(--text-tertiary); font-size: 10px; }
  .footer-bottom a { text-decoration: none; }
  @media (max-width: 760px) { .footer-top { flex-wrap: wrap; gap: 24px 30px; } .footer-top > a:last-child { margin-left: 0; width: 100%; justify-content: space-between; } .footer-bottom > span:nth-child(2) { display: none; } }
</style>
