---
import Logo from './Logo.astro';
---
<footer class="site-footer container">
  <div class="footer-top">
    <a href="/" class="footer-brand" aria-label="strided home"><Logo size={54} /></a>
    <p>Local models.<br />Tuned while they run.</p>
    <div class="footer-links">
      <a href="/submit" class="text-link">Share a workload <span class="arrow" aria-hidden="true">→</span></a>
      <a href="mailto:hello@strided.dev" class="text-link">hello@strided.dev <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} strided</span><span>Observe. Adjust. Verify.</span><a href="#main">Back to top ↑</a></div>
</footer>
<style>
  .site-footer { padding-block: 44px 24px; }
  .footer-top { display: flex; align-items: center; gap: 60px; padding-bottom: 35px; }
  .footer-brand { display: flex; text-decoration: none; }
  .footer-top > p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
  .footer-links { display: flex; gap: 12px 40px; margin-left: auto; }
  .footer-links a { font-size: 12px; gap: 22px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 22px; color: var(--text-tertiary); font-size: 10px; }
  .footer-bottom a { text-decoration: none; }
  @media (max-width: 760px) {
    .footer-top { flex-wrap: wrap; gap: 24px 30px; }
    .footer-links { margin-left: 0; width: 100%; flex-direction: column; }
    .footer-links a { justify-content: space-between; }
    .footer-bottom > span:nth-child(2) { display: none; }
  }
</style>
