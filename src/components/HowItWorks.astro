---
const steps = [
  { title: 'Observe the workload.', body: 'Start with the tools your engineers already use. Bring Nsight, DCGM, or vLLM telemetry into a common view.', detail: 'Existing signals. Shared context.' },
  { title: 'Explain the constraint.', body: 'Evaluate explicit rules against the evidence. Every diagnosis includes a cause, a confidence score, and the signals behind it.', detail: 'Inspectable reasoning. Clear limits.' },
  { title: 'Verify the change.', body: 'Review a proposed fix, compare the result with the baseline, and keep a path back. A recommendation is only the beginning.', detail: 'Measured outcomes. Reversible steps.' },
];
---
<div class="approach container">
  <div class="approach-heading">
    <div><p class="eyebrow">Our approach</p><h2 id="approach-title">Performance you can<br />account for.</h2></div>
    <p class="approach-description">Start with a real capture. Explain the constraint through explicit rules, then verify a proposed change against the baseline. Every conclusion should be inspectable and every limitation visible.</p>
  </div>
  <div class="steps">
    {steps.map(step => <article class="step">
      <h3>{step.title}</h3>
      <p>{step.body}</p>
      <div class="step-detail">{step.detail}</div>
    </article>)}
  </div>
  <div class="accountability">
    <p>Same evidence. Same rules. Same diagnosis.</p>
    <span class="accountability-note">When the evidence is insufficient, abstain.</span>
  </div>
</div>
<style>
  .approach { padding-block: var(--section-space); }
  .approach-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
  .approach-heading .eyebrow { margin-bottom: 26px; }
  .approach-description { max-width: 520px; font-size: 14px; color: var(--text-secondary); line-height: 1.85; padding-bottom: 5px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px; margin-top: 60px; }
  .step h3 { font-size: 29px; margin-bottom: 18px; }
  .step > p { font-size: 14px; color: var(--text-secondary); line-height: 1.85; }
  .step-detail { font-size: 12px; color: var(--text-secondary); margin-top: 24px; }
  .accountability { margin-top: 72px; }
  .accountability p { font: 400 clamp(25px, 2.3vw, 32px)/1.3 var(--font-display); letter-spacing: -.015em; }
  .accountability-note { display: block; font-size: 12px; color: var(--text-secondary); margin-top: 10px; }
  @media (max-width: 950px) { .steps { gap: 32px; } .approach-heading { gap: 40px; } }
  @media (max-width: 760px) { .approach-heading { grid-template-columns: 1fr; gap: 28px; } .steps { grid-template-columns: 1fr; gap: 40px; margin-top: 40px; } .step-detail { margin-top: 16px; } .accountability { margin-top: 48px; } }
</style>
