---
const steps = [
  { n: '01', title: 'Observe the workload.', body: 'Start with the tools your engineers already use. Bring Nsight, DCGM, or vLLM telemetry into a common view.', detail: 'Existing signals. Shared context.' },
  { n: '02', title: 'Explain the constraint.', body: 'Evaluate explicit rules against the evidence. Every diagnosis includes a cause, a confidence score, and the signals behind it.', detail: 'Inspectable reasoning. Clear limits.' },
  { n: '03', title: 'Verify the change.', body: 'Review a proposed fix, compare the result with the baseline, and keep a path back. A recommendation is only the beginning.', detail: 'Measured outcomes. Reversible steps.' },
];
---
<section class="approach container" id="approach" aria-labelledby="approach-title">
  <div class="approach-heading">
    <p class="eyebrow"><span class="index">03 /</span> The engineering standard</p>
    <h2 id="approach-title">Performance you can<br />account for.</h2>
  </div>
  <div class="steps">
    {steps.map(step => <article class="step">
      <div class="step-top"><span>{step.n}</span><span aria-hidden="true">↗</span></div>
      <h3>{step.title}</h3>
      <p>{step.body}</p>
      <div class="step-detail">{step.detail}</div>
    </article>)}
  </div>
  <div class="accountability">
    <span class="accountability-symbol" aria-hidden="true">[ = ]</span>
    <p>Same evidence. Same rules. Same diagnosis.</p>
    <span class="accountability-note">When the evidence is insufficient, abstain.</span>
  </div>
</section>
<style>
  .approach { padding-block: var(--section-space); }
  .approach-heading .eyebrow { margin-bottom: 26px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; margin-top: 54px; }
  .step { border-top: 1px solid var(--border-primary); padding-top: 16px; }
  .step-top { display: flex; justify-content: space-between; font: 11px/1.5 var(--font-mono); color: var(--text-secondary); margin-bottom: 35px; }
  .step-top span:last-child { font-family: var(--font-sans); font-size: 18px; }
  .step h3 { font-size: 29px; margin-bottom: 18px; }
  .step > p { font-size: 14px; color: var(--text-secondary); line-height: 1.85; }
  .step-detail { font: 10px/1.7 var(--font-mono); color: var(--text-secondary); margin-top: 28px; }
  .accountability { margin-top: 60px; border: 1px solid var(--border-primary); padding: 26px 28px; display: flex; align-items: center; gap: 25px; }
  .accountability-symbol { font: 16px/1.5 var(--font-mono); color: var(--text-secondary); }
  .accountability p { font-size: 14px; }
  .accountability-note { margin-left: auto; font: 10px/1.7 var(--font-mono); color: var(--text-secondary); }
  @media (max-width: 950px) { .steps { gap: 25px; } .accountability { flex-wrap: wrap; gap: 15px 25px; } .accountability-note { margin-left: 0; } }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; gap: 35px; margin-top: 36px; } .step-top { margin-bottom: 22px; } .step-detail { margin-top: 18px; } .accountability { padding: 24px; margin-top: 38px; } .accountability-symbol { display: none; } }
</style>
