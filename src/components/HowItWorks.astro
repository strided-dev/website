---
const steps = [
  { title: 'Bring a model.', body: 'Start with the model you want to host and the hardware available to run it. Establish a memory budget and the workload you need to serve.', detail: 'Your model. Your machine.' },
  { title: 'Let the runtime adjust.', body: 'As prompts and request volume change, strided will adjust batching, concurrency, and cache use within your configured limits.', detail: 'Automatic adjustments. Explicit boundaries.' },
  { title: 'Check what changed.', body: 'See the settings before and after an adjustment, along with the signals that prompted it. Compare the result and return to the previous configuration when needed.', detail: 'Visible decisions. A way back.' },
];
---
<div class="approach container">
  <div class="approach-heading">
    <div><p class="eyebrow">Our approach</p><h2 id="approach-title">Less manual tuning.<br />Clearer control.</h2></div>
    <p class="approach-description">The aim is simple: host a model, give it sensible limits, and let strided adjust the runtime as conditions change. Automation should make local hosting easier to understand and operate.</p>
  </div>
  <div class="steps">
    {steps.map(step => <article class="step">
      <h3>{step.title}</h3>
      <p>{step.body}</p>
      <div class="step-detail">{step.detail}</div>
    </article>)}
  </div>
  <div class="accountability">
    <p>Automatic adjustments. Visible decisions.</p>
    <span class="accountability-note">When a change cannot be justified, keep the current settings.</span>
  </div>
</div>
<style>
  .approach { padding-block: var(--section-space); }
  .approach-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
  .approach-heading .eyebrow { margin-bottom: 26px; }
  .approach-description { max-width: 520px; font-size: 14px; color: var(--text-secondary); line-height: 1.85; padding-bottom: 5px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px; margin-top: 60px; }
  .step h3 { font-size: 29px; margin-bottom: 18px; }
  .step > p { font-size: 14px; color: var(--text-secondary); line-height: 1.85; }
  .step-detail { font-size: 12px; color: var(--text-secondary); margin-top: 24px; }
  .accountability { margin-top: 72px; }
  .accountability p { font: 400 clamp(25px, 2.3vw, 32px)/1.3 var(--font-display); letter-spacing: -.015em; }
  .accountability-note { display: block; font-size: 12px; color: var(--text-secondary); margin-top: 10px; }
  @media (max-width: 950px) { .steps { gap: 32px; } .approach-heading { gap: 40px; } }
  @media (max-width: 760px) { .approach-heading { grid-template-columns: 1fr; gap: 28px; } .steps { grid-template-columns: 1fr; gap: 40px; margin-top: 40px; } .step-detail { margin-top: 16px; } .accountability { margin-top: 48px; } }
</style>
