---
const steps = [
  { n: "STEP 01", h: "Capture", p: "Run Nsight Compute, DCGM, or vLLM /metrics against your inference workload. Standard tools, standard outputs." },
  { n: "STEP 02", h: "Parse", p: "strided normalizes the dump into a canonical schema. Phase timings, layer-level metrics, cluster signals, cache state." },
  { n: "STEP 03", h: "Fire rules", p: "Ten deterministic rules evaluate the schema. KV fragmentation, NCCL dominance, TP imbalance, quantization opportunity, more." },
  { n: "STEP 04", h: "Rank", p: "Each fired rule carries a confidence score and a suggested fix. Ambiguous case → no diagnosis. We don't guess." },
];
---

<section class="how" id="how">
  <div class="how-content">
    <h2>Parse. Diagnose. <span class="amber">Done.</span></h2>
    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <div class="step-num">{s.n}</div>
          <h4>{s.h}</h4>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how { padding: var(--pad-y) var(--pad-x); border-bottom: 0.5px solid var(--border-primary); }
  .how-content { max-width: 1080px; margin: 0 auto; }
  .how h2 { font-size: var(--fs-h2); font-weight: 600; letter-spacing: -2px; margin-bottom: clamp(var(--space-8), 5vw, 56px); max-width: 720px; line-height: 1.1; }
  .how h2 .amber { color: var(--amber); }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .step { border-top: 0.5px solid var(--border-primary); padding-top: var(--space-4); }
  .step-num { font-family: var(--font-mono); font-size: 11px; color: var(--text-tertiary); letter-spacing: 1.5px; margin-bottom: var(--space-3); }
  .step h4 { font-size: 16px; font-weight: 500; margin-bottom: var(--space-2); }
  .step p { font-size: 14px; color: var(--text-secondary); line-height: 1.5; }

  @media (max-width: 760px) { .steps { grid-template-columns: 1fr 1fr; gap: var(--space-8) var(--space-6); } }
  @media (max-width: 420px) { .steps { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
