---
const cards = [
  { num: "01 / WHAT", h: "A diagnosis engine, not a profiler.", p: "Existing tools tell you your GPU is slow. strided tells you <em>why</em> it's slow, what to do about it, and how confident we are in the answer." },
  { num: "02 / WHO", h: "For people who can't keep ten senior CUDA engineers on staff.", p: "A senior engineer with two days of Nsight can find the bottleneck. strided turns that capability into a CLI you can run on every dump." },
  { num: "03 / WHY", h: "The gap is the business.", p: "You bought H100-hours. Your workload only used 60% of theoretical FLOPS. The gap between rental rate and realized compute is real money. strided measures it." },
];
---

<section class="thesis">
  <div class="thesis-grid">
    {cards.map((c) => (
      <div class="thesis-card">
        <div class="thesis-num">{c.num}</div>
        <h3>{c.h}</h3>
        <p set:html={c.p} />
      </div>
    ))}
  </div>
</section>

<style>
  .thesis {
    padding: var(--pad-y) var(--pad-x);
    border-bottom: 0.5px solid var(--border-primary);
    background: var(--paper-inset);
    transition: background var(--dur-theme) var(--ease-instrument);
  }
  .thesis-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-12); max-width: 1200px; margin: 0 auto; }
  .thesis-num { font-family: var(--font-mono); font-size: 11px; color: var(--amber); letter-spacing: 1.5px; margin-bottom: var(--space-4); }
  .thesis-card h3 { font-size: var(--fs-h3); font-weight: 500; letter-spacing: -0.5px; line-height: 1.3; margin-bottom: var(--space-4); }
  .thesis-card p { color: var(--text-secondary); font-size: 15px; line-height: 1.6; }
  .thesis-card :global(em) { font-style: italic; color: var(--text-primary); }

  @media (max-width: 860px) {
    .thesis-grid { grid-template-columns: 1fr; gap: var(--space-8); max-width: 60ch; }
  }
</style>
