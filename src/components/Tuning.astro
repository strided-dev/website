---
import TrialExplorer from './TrialExplorer.tsx';
const steps = [
  { actor: 'strided', title: 'Observe.', body: 'strided turns each engine step into rule inputs and runs six deterministic rules every second, from queue growth and KV cache pressure to memory-bound decode. Each finding carries a confidence score.', detail: 'Abstains when the evidence is missing.' },
  { actor: 'gait', title: 'Test.', body: 'gait writes down a prediction, then runs the candidate beside the current setting, switching every 200 steps until both sides have enough evidence to compare.', detail: 'One setting per trial. Live traffic, no downtime.', automatic: true },
  { actor: 'gait', title: 'Keep or revert.', body: 'A change stays only when the objective improves with a 95% confidence interval above zero and every latency limit holds. Anything else is undone through the setting\'s declared inverse.', detail: 'Every phase journaled, hash-chained.' },
];
const tiers = [
  { name: 'Performance settings', rule: 'Applied automatically', body: 'Sequences per step, prefill chunk size, schedule policy, decode attention splits, and graph capture.' },
  { name: 'Resource settings', rule: 'Only with --allow-resource', flag: true, body: 'Queue limits and the cache preemption watermark: settings that can turn work away or change what fits.' },
  { name: 'Quality settings', rule: 'Only with your approval', body: 'Temperature, top-p, top-k, and repeat penalty. gait never changes how the model answers on its own.' },
];
---
<section class="tuning-section" id="tuning" aria-labelledby="tuning-title">
  <div class="tuning container">
    <div class="tuning-heading">
      <div><p class="eyebrow">Live tuning</p><h2 id="tuning-title">Tuned while it serves.<br />Proven before it stays.</h2></div>
      <p class="tuning-description">strided and gait run inside vivace on their own threads. They read the telemetry the engine writes on every step and change settings through one validated path, never by reaching into the engine.</p>
    </div>
    <ol class="steps" role="list">
      {steps.map(step => <li class="step">
        <p class="step-actor">{step.actor}</p>
        <h3 class:list={{ 'strided-emphasis': step.automatic }}>{step.title}</h3>
        <p>{step.body}</p>
        <p class="step-detail">{step.detail}</p>
      </li>)}
    </ol>

    <div class="authority">
      <div class="authority-heading"><p class="eyebrow">Authority</p><h3>You set the limits.<br />gait works inside them.</h3></div>
      <ul class="tiers" role="list">
        {tiers.map(tier => <li>
          <h4>{tier.name}</h4>
          <p class="tier-rule">{tier.flag ? <>Only with <code>--allow-resource</code></> : tier.rule}</p>
          <p class="tier-body">{tier.body}</p>
        </li>)}
      </ul>
      <p class="authority-note">A kept change lasts until vivace restarts. The trial report names the flag that makes it permanent.</p>
    </div>

    <div class="accountability">
      <p>A guardrail watches every change.</p>
      <span class="accountability-note">If p99 time per token rises past 1.5 times its baseline, the engine reverts the change on the next step.</span>
    </div>
  </div>

  <div class="trial-band" id="trial">
    <div class="container">
      <div class="trial-heading">
        <div><p class="eyebrow">One trial, step by step</p><h3 id="trial-title">Side by side.<br />Then a verdict.</h3></div>
        <p>An illustrative gait trial on live traffic. The candidate setting (B) alternates with the current one (A) every 200 decode steps. Choose an outcome to see how gait reads the evidence.</p>
      </div>
      <TrialExplorer client:load />
    </div>
  </div>
</section>
<style>
  .tuning { padding-block: var(--section-space); }
  .tuning-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; }
  .tuning-heading .eyebrow { margin-bottom: 26px; }
  .tuning-description { max-width: 540px; font-size: 16px; color: var(--text-secondary); line-height: 1.75; padding-bottom: 5px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px; margin: 60px 0 0; padding: 0; list-style: none; }
  .step-actor { font: 12px/1.5 var(--font-mono); color: var(--text-secondary); margin-bottom: 14px; }
  .step h3 { font-size: 29px; margin-bottom: 18px; }
  .step > p:not(.step-actor):not(.step-detail) { font-size: 16px; color: var(--text-secondary); line-height: 1.75; }
  .step-detail { font-size: 12px; color: var(--text-secondary); margin-top: 24px; }
  .authority { margin-top: 88px; display: grid; grid-template-columns: 1fr 2fr; gap: 56px; }
  .authority-heading .eyebrow { margin-bottom: 18px; }
  .authority-heading h3 { font-size: 29px; }
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 0; padding: 0; list-style: none; }
  .tiers h4 { font: 500 13px/1.5 var(--font-sans); letter-spacing: normal; }
  .tier-rule { font-size: 13px; line-height: 1.6; color: var(--strided-purple); margin-top: 6px; }
  .tier-rule code { font: 12px/1.6 var(--font-mono); }
  .tier-body { font-size: 14px; line-height: 1.7; color: var(--text-secondary); margin-top: 12px; }
  .authority-note { grid-column: 2; font-size: 12px; color: var(--text-secondary); margin-top: -24px; }
  .accountability { margin-top: 72px; }
  .accountability p { font: 400 clamp(25px, 2.3vw, 32px)/1.3 var(--font-display); letter-spacing: -.015em; }
  .accountability-note { display: block; font-size: 12px; color: var(--text-secondary); margin-top: 10px; }
  .trial-band { background: var(--paper-card); padding-block: var(--section-space); }
  .trial-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; margin-bottom: 44px; }
  .trial-heading .eyebrow { margin-bottom: 18px; }
  .trial-heading h3 { font-size: 29px; }
  .trial-heading > p { max-width: 540px; font-size: 15px; line-height: 1.75; color: var(--text-secondary); }
  @media (max-width: 1050px) { .authority { grid-template-columns: 1fr; gap: 28px; } .authority-note { grid-column: 1; margin-top: 0; } }
  @media (max-width: 950px) { .steps, .tiers { gap: 32px; } .tuning-heading, .trial-heading { gap: 40px; } }
  @media (max-width: 760px) {
    .tuning-heading, .trial-heading { grid-template-columns: 1fr; gap: 28px; }
    .trial-heading { gap: 16px; margin-bottom: 32px; }
    .steps { grid-template-columns: 1fr; gap: 40px; margin-top: 40px; }
    .step-detail { margin-top: 16px; }
    .authority { margin-top: 64px; }
    .tiers { grid-template-columns: 1fr; gap: 24px; }
    .accountability { margin-top: 48px; }
  }
</style>
